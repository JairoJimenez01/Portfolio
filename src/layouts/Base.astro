---
import { Font } from 'astro:assets';
import 'lenis/dist/lenis.css';
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Menu from '@/components/layout/Menu.astro';
import { DEFAULT_LOCALE, getDictionary, LOCALE_INFO, LOCALES, type Locale } from '@/i18n';
import { serializeJsonLd } from '@/lib/seo';
import { absoluteUrl, localeHomePath, ogImagePath, withBase } from '@/lib/urls';

/** Esqueleto de toda página: metadatos, fuentes, cabecera, menú y scripts. */
interface Props {
  locale: Locale;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { locale, title, description, jsonLd } = Astro.props;
const t = getDictionary(locale);

const site = Astro.site ?? new URL('http://localhost:4321');
const base = import.meta.env.BASE_URL;
const urlOf = (path: string) => absoluteUrl(site, base, path);

const canonical = urlOf(localeHomePath(locale));
const ogImage = urlOf(ogImagePath(locale));
/** Versiones de la página en cada idioma, para buscadores (hreflang). */
const alternates = LOCALES.map((alternate) => ({
  locale: alternate,
  href: urlOf(localeHomePath(alternate)),
}));
const otherLocales = LOCALES.filter((other) => other !== locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    ))}
    <!-- Versión para idiomas que el sitio no tiene: la del idioma por defecto -->
    <link rel="alternate" hreflang="x-default" href={urlOf(localeHomePath(DEFAULT_LOCALE))} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#121016" />
    <meta name="generator" content={Astro.generator} />

    <!-- Previsualización del enlace en LinkedIn, portales de empleo y mensajería -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={LOCALE_INFO[locale].ogLocale} />
    {otherLocales.map((other) => (
      <meta property="og:locale:alternate" content={LOCALE_INFO[other].ogLocale} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fuentes servidas desde el propio dominio (astro.config.ts) -->
    <Font cssVariable="--font-sora" preload={[{ weight: 800, subset: 'latin' }]} />
    <Font cssVariable="--font-dm-sans" preload={[{ weight: 400, subset: 'latin' }]} />
    <Font cssVariable="--font-plex-mono" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

    <!--
      Marca que hay JavaScript antes del primer pintado: activa las animaciones de aparición.
      Red de seguridad: si el JavaScript principal no ha arrancado en 3 s, se retira la marca
      para que el contenido nunca se quede oculto.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        setTimeout(() => {
          if (!root.classList.contains('js-ready')) root.classList.remove('js');
        }, 3000);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#top">
      {t.nav.skipToContent}
    </a>
    <Header locale={locale} />
    <Menu locale={locale} />
    <main id="top">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
