---
import { Font } from 'astro:assets';
import 'lenis/dist/lenis.css';
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Menu from '@/components/layout/Menu.astro';
import { getDictionary } from '@/i18n';
import { serializeJsonLd } from '@/lib/seo';
import { absoluteUrl, withBase } from '@/lib/urls';

/** Esqueleto de toda página: metadatos, fuentes, cabecera, menú y scripts. */
interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const t = getDictionary();

const site = Astro.site ?? new URL('http://localhost:4321');
const base = import.meta.env.BASE_URL;
const canonical = absoluteUrl(site, base, '/');
const ogImage = absoluteUrl(site, base, '/og.png');
---

<!doctype html>
<html lang={t.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#121016" />
    <meta name="generator" content={Astro.generator} />

    <!-- Previsualización del enlace en LinkedIn, portales de empleo y mensajería -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fuentes servidas desde el propio dominio (astro.config.ts) -->
    <Font cssVariable="--font-sora" preload={[{ weight: 800, subset: 'latin' }]} />
    <Font cssVariable="--font-dm-sans" preload={[{ weight: 400, subset: 'latin' }]} />
    <Font cssVariable="--font-plex-mono" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

    <!--
      Marca que hay JavaScript antes del primer pintado: activa las animaciones de aparición.
      Red de seguridad: si el JavaScript principal no ha arrancado en 3 s, se retira la marca
      para que el contenido nunca se quede oculto.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        setTimeout(() => {
          if (!root.classList.contains('js-ready')) root.classList.remove('js');
        }, 3000);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#top">
      {t.nav.skipToContent}
    </a>
    <Header />
    <Menu />
    <main id="top">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
