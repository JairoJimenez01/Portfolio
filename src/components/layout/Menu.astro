---
import { getDictionary, type Locale } from '@/i18n';
import { languageLinks, navigationItems } from '@/lib/navigation';

/**
 * Menú a pantalla completa para móvil: secciones arriba e idiomas abajo.
 * El comportamiento está en scripts/menu.ts.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const items = navigationItems(t);
const languages = languageLinks(locale, import.meta.env.BASE_URL);
---

<div class="menu" id="menu" data-menu data-open="false">
  <button class="menu__close" type="button" data-menu-close>
    {t.nav.close}
  </button>
  <nav class="menu__sections" aria-label={t.nav.menuLabel}>
    {items.map((item, index) => (
      <a class="menu__link" href={item.href} style={`--i:${index}`}>
        {item.label}
      </a>
    ))}
  </nav>
  <nav class="menu__languages" aria-label={t.nav.languageLabel} style={`--i:${items.length}`}>
    <ul class="menu__language-list">
      {languages.map((language) => (
        <li>
          <a
            class="menu__language"
            href={language.href}
            hreflang={language.locale}
            lang={language.locale}
            aria-current={language.current ? 'page' : undefined}
          >
            {language.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  /*
   * Cerrado, el menú se recorta hacia arriba y queda oculto también para el teclado y los
   * lectores de pantalla (visibility). Al cerrar, la visibilidad cambia cuando termina el recorte.
   */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: calc(5rem + env(safe-area-inset-top, 0px));
    padding-bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));
    padding-left: var(--gutter-l);
    padding-right: var(--gutter-r);
    overflow-y: auto;
    background: var(--ink);
    color: var(--fg-on-ink);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.6s var(--ease-out),
      visibility 0s linear 0.6s;
  }

  .menu[data-open='true'] {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path 0.6s var(--ease-out),
      visibility 0s;
  }

  .menu__close {
    position: absolute;
    top: calc(1.1rem + env(safe-area-inset-top, 0px));
    right: var(--gutter-r);
    border: 0;
    background: none;
    font-weight: 500;
    cursor: pointer;
  }

  .menu__sections {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .menu__link,
  .menu__languages {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
    transition-delay: calc(var(--i) * 70ms + 150ms);
  }

  .menu[data-open='true'] .menu__link,
  .menu[data-open='true'] .menu__languages {
    opacity: 1;
    transform: none;
  }

  .menu__link {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 10vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .menu__link:hover {
    color: var(--accent);
  }

  /* Idiomas al pie del menú, como una fila de pastillas. */
  .menu__languages {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-on-ink);
  }

  .menu__language-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .menu__language {
    display: block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--line-on-ink);
    border-radius: var(--radius-pill);
    font-weight: 500;
    color: var(--fg-on-ink-muted);
    transition:
      border-color 0.3s,
      color 0.3s;
  }

  .menu__language:hover {
    border-color: var(--accent);
    color: var(--fg-on-ink);
  }

  .menu__language[aria-current='page'] {
    border-color: var(--fg-on-ink);
    background: var(--fg-on-ink);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu[data-open='true'],
    .menu__link,
    .menu__languages,
    .menu__language {
      transition: none;
    }
  }
</style>
