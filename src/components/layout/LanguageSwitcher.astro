---
import Icon from '@/components/ui/Icon.astro';
import { getDictionary, LOCALE_INFO, type Locale } from '@/i18n';
import { languageLinks } from '@/lib/navigation';

/**
 * Selector de idioma de escritorio: un botón con el idioma actual que despliega la lista.
 *
 * Usa la API de popover del navegador (`popovertarget` + `popover`), sin JavaScript propio:
 * abre y cierra con el botón, se cierra al pulsar fuera o con Escape, y el foco pasa a la lista.
 * Además, el panel se pinta en la capa superior del documento, fuera de la cabecera, así que
 * no le afecta su mix-blend-mode y se ve con sus propios colores sobre cualquier banda.
 *
 * No redirige según el idioma del navegador: quien llega a una URL ve esa URL.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const links = languageLinks(locale, import.meta.env.BASE_URL);
const PANEL_ID = 'language-panel';
---

<button
  class="language__trigger"
  type="button"
  popovertarget={PANEL_ID}
  aria-label={`${t.nav.languageLabel}: ${LOCALE_INFO[locale].name}`}
>
  <Icon name="globe" size="1rem" />
  <span class="language__code">{locale}</span>
  <span class="language__chevron">
    <Icon name="chevron" size="0.8rem" />
  </span>
</button>

<nav id={PANEL_ID} class="language__panel" popover aria-label={t.nav.languageLabel}>
  <ul class="language__list">
    {links.map((link) => (
      <li>
        <a
          class="language__option"
          href={link.href}
          hreflang={link.locale}
          lang={link.locale}
          aria-current={link.current ? 'page' : undefined}
        >
          <span>{link.name}</span>
          {link.current && <Icon name="check" size="1rem" />}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .language__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    background: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 0.3s;
  }

  .language__trigger:hover,
  .language__trigger:has(+ .language__panel:popover-open) {
    opacity: 1;
  }

  .language__chevron {
    display: inline-flex;
    transition: rotate 0.3s var(--ease-out);
  }

  .language__trigger:has(+ .language__panel:popover-open) .language__chevron {
    rotate: 180deg;
  }

  /*
   * Panel bajo el botón, alineado con el borde derecho del contenido de la cabecera.
   * El 100% es el ancho de la ventana: el panel se posiciona respecto a ella (position: fixed).
   */
  .language__panel {
    inset: auto;
    top: calc(env(safe-area-inset-top, 0px) + 3.9rem);
    right: max(var(--gutter-r), calc((100% - var(--container)) / 2 + var(--gutter-r)));
    min-width: 11rem;
    margin: 0;
    padding: 0.4rem;
    border: 1px solid var(--line-on-ink);
    border-radius: 16px;
    background: var(--ink);
    color: var(--fg-on-ink);
    box-shadow: 0 24px 48px -20px rgb(18 16 22 / 0.55);
    opacity: 0;
    translate: 0 -6px;
    transition:
      opacity 0.2s,
      translate 0.25s var(--ease-out),
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }

  .language__panel:popover-open {
    opacity: 1;
    translate: 0 0;
  }

  /* Estado de partida de la animación al abrir (el panel pasa de display: none a visible). */
  @starting-style {
    .language__panel:popover-open {
      opacity: 0;
      translate: 0 -6px;
    }
  }

  .language__list {
    display: grid;
    gap: 0.15rem;
  }

  .language__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.6rem 0.8rem;
    border-radius: 10px;
    font-weight: 500;
    color: var(--fg-on-ink-muted);
    transition:
      background 0.2s,
      color 0.2s;
  }

  .language__option:hover,
  .language__option:focus-visible {
    background: var(--ink-2);
    color: var(--fg-on-ink);
  }

  .language__option[aria-current='page'] {
    color: var(--fg-on-ink);
  }

  .language__option[aria-current='page'] :global(svg) {
    color: var(--accent-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .language__trigger,
    .language__chevron,
    .language__panel,
    .language__option {
      transition: none;
    }
  }
</style>
